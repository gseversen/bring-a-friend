# Copy to .env (gitignored) and fill in. All three apps read this one file.

# --- agent (apps/agent) ---
ANTHROPIC_API_KEY=
# Any Anthropic model ID. Change without touching code (e.g. claude-sonnet-5
# for lower cost and latency).
ANTHROPIC_MODEL=claude-opus-5
# Server-side refusal fallbacks ("default" = Anthropic picks the fallback model).
# Leave empty if you switch to a model that doesn't support them.
ANTHROPIC_FALLBACKS=default
# 1 = use a scripted fake LLM (no API key, no cost). Handy for demos and tests.
AGENT_MOCK_LLM=0
AGENT_PORT=8000
# Where the agent sends timeline events.
SYNC_HTTP_URL=http://localhost:1234
# Browser origin allowed to call the agent (CORS).
WEB_ORIGIN=http://localhost:5173

# --- sync (apps/sync) ---
SYNC_PORT=1234

# --- web (apps/web) --- (Vite only exposes VITE_* vars to the browser)
VITE_SYNC_URL=ws://localhost:1234
VITE_AGENT_URL=http://localhost:8000
